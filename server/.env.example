# Caretaker AI server settings. Copy to .env (gitignored) and fill in:  cp .env.example .env

# ---- Garden location (required) ----
# Decimal degrees, e.g. from a long-press in your maps app. Used for the weather forecast.
LATITUDE=
LONGITUDE=
# IANA timezone of the garden, e.g. America/Denver. Empty = this computer's timezone.
TIMEZONE=

# ---- Phone notifications via Bark (iOS), end-to-end encrypted ----
# 1. Install "Bark - Custom Notifications" from the App Store and allow notifications.
# 2. Copy your device key: the random string in the app's example URLs,
#    e.g. https://api.day.app/XXXXXXXXXXXXXXXXXXXXXX/...  ->  BARK_DEVICE_KEY=XXXXXXXXXXXXXXXXXXXXXX
# 3. In the app: Push Encryption -> Algorithm AES256, Mode CBC,
#    KEY = the 32-character BARK_ENCRYPTION_KEY below. IV: leave empty if allowed, otherwise any
#    16 characters - the server sends a fresh random IV with every message, which takes priority.
#    Generate a key:  openssl rand -hex 16
# 4. Test:  npm run test-notify   (installed copy: node dist/cli/test-notify.js)
BARK_SERVER=https://api.day.app
BARK_DEVICE_KEY=
BARK_ENCRYPTION_KEY=
BARK_GROUP=Caretaker
BARK_CRITICAL_ALERTS=false    # true = "running long" alert rings even on silent (allow Critical Alerts for Bark first)

# ---- MQTT (the broker built into the server; the ESP32s connect to it) ----
MQTT_PORT=1883
MQTT_USERNAME=sprinkler
MQTT_PASSWORD=change-me      # must match MQTT_PASSWORD in the firmware config.h
MQTT_TOPIC_BASE=sprinkler     # zones use sprinkler/zone1, sprinkler/zone2, ...; must match the firmware's config.h

# ---- Web dashboard ----
WEB_PORT=8080                 # deploy/install.sh sets 80 for the installed service
# Set to require a password (browser will prompt; any username). Empty = no auth.
WEB_PASSWORD=

# ---- Watering rules ----
AUTO_ENABLED=true
DRY_HOURS_THRESHOLD=240       # plain rule: water after this long without rain or watering (also the AI fallback)
AUTO_RUN_MINUTES=10
WATER_WINDOW_START_HOUR=5     # automatic runs only start between these local hours
WATER_WINDOW_END_HOUR=9       # set 0 and 24 to allow any time
DEFAULT_MANUAL_MINUTES=30

# ---- Weather thresholds (Open-Meteo, free, no API key) ----
WEATHER_POLL_MINUTES=15
RAIN_RECORD_MIN_MM=0.5              # an hour with >= this counts as "it rained"
FORECAST_RAIN_MIN_MM=0.5            # forecast hour with >= this blocks watering
FORECAST_RAIN_MIN_PROBABILITY=50    # ...or with >= this % chance
FORECAST_HORIZON_HOURS=24

# ---- Alerts ----
LONG_RUN_ALERT_MINUTES=30           # notify if ON longer than this
LONG_RUN_ALERT_REPEAT_MINUTES=15
OFFLINE_ALERT_MINUTES=3

DATA_DIR=./data

# ---- Zones: one per valve, in the order of RELAY_PINS in the firmware's config.h ----
# Emitters turn minutes into gallons until a flow meter has data. EMITTER_COUNT=0 = not known yet.
# New zones start with their automatic watering off; turn it on with the zone's Auto switch.
ZONE_COUNT=1
ZONE1_NAME=Zone 1
ZONE1_EMITTER_COUNT=40
ZONE1_EMITTER_GPH=5
# A second valve (RELAY_PINS {26, 25}): set ZONE_COUNT=2 and describe it
#ZONE2_NAME=Zone 2
#ZONE2_EMITTER_COUNT=0
#ZONE2_EMITTER_GPH=1
# Optional per zone: a shorter minimum gap between AI waterings, e.g. for pots in full sun
#ZONE2_AI_MIN_HOURS_BETWEEN_WATERINGS=24

# ---- Flow sensor on a valve outlet (FLOW_PIN and FLOW_ZONE in the firmware's config.h) ----
# FS400A G1": 288 pulses per liter (F = 4.8 x L/min). To calibrate, read the water
# meter before and after a run: new value = 288 x (logged gal / meter gal).
FLOW_PULSES_PER_LITER=288
# Urgent alert when water flows this fast with the valve closed (stuck valve, leak)
FLOW_LEAK_GPM=0.25
FLOW_LEAK_MINUTES=3
# Alert when the valve has been open this long but less than FLOW_NO_FLOW_GPM flows
FLOW_NO_FLOW_SECONDS=90
FLOW_NO_FLOW_GPM=0.1

# ---- AI gardener (Claude API) ----
# Get a key at console.anthropic.com (API Keys). Billing is separate from a claude.ai subscription.
ANTHROPIC_API_KEY=
AI_MODE=advise                      # off | advise (decide + notify only) | auto (AI plan waters)
AI_MODEL=claude-opus-5-5
AI_EFFORT=high                      # low | medium | high | xhigh | max
AI_DECISION_HOUR=4                  # daily decision at 4:30 local time
AI_DECISION_MINUTE=30
GARDEN_FILE=./garden.md             # your yard, sent with every decision (start from garden.example.md)
# Guardrails: enforced in code no matter what the AI asks for
AI_MAX_MINUTES_PER_DAY=30
AI_MAX_CYCLE_MINUTES=15
AI_MAX_CYCLES=4
AI_MIN_SOAK_MINUTES=15
AI_MAX_SOAK_MINUTES=90
AI_MIN_HOURS_BETWEEN_WATERINGS=48  # per zone; ZONE<N>_AI_MIN_HOURS_BETWEEN_WATERINGS overrides it
