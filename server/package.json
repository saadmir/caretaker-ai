{
  "name": "caretaker-ai-server",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --import ./test/env.ts --test test/*.test.ts",
    "simulate": "tsx tools/simulate-esp32.ts",
    "test-notify": "tsx src/cli/test-notify.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "aedes": "^1.2.0",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "mqtt": "^5.16.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "description": "Caretaker AI home server: MQTT broker, AI gardener, rules, dashboard"
}
